# Mac external-drive storage
VLM_STORAGE_ROOT=/Volumes/VLM/tinyllava-repro

# Model and framework caches
HF_HOME=/Volumes/VLM/tinyllava-repro/cache/huggingface
HF_DATASETS_CACHE=/Volumes/VLM/tinyllava-repro/cache/huggingface/datasets
TORCH_HOME=/Volumes/VLM/tinyllava-repro/cache/torch

# Project artifacts
VLM_DATA_ROOT=/Volumes/VLM/tinyllava-repro/data
VLM_MODEL_ROOT=/Volumes/VLM/tinyllava-repro/models
VLM_CHECKPOINT_ROOT=/Volumes/VLM/tinyllava-repro/checkpoints
